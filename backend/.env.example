DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEFAULT_FROM_EMAIL=accounts@localhost
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
PASSWORD_RESET_TIMEOUT=3600
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# In production set DJANGO_ENV=production and DJANGO_DEBUG=False, then provide:
# DJANGO_SECRET_KEY=<generated secret of at least 50 characters>
# DJANGO_ALLOWED_HOSTS=<explicit comma-separated hostnames>
# DJANGO_EMAIL_HOST=<TLS-enabled SMTP host>
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=<SMTP username, if required>
# DJANGO_EMAIL_PASSWORD=<SMTP password, if required>
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=<verified sender address>
# DJANGO_CACHE_BACKEND=<shared Django cache backend>
# DJANGO_CACHE_LOCATION=<shared cache location>
# CORS_ALLOWED_ORIGINS=https://<frontend-origin>
# CSRF_TRUSTED_ORIGINS=https://<admin-origin>
# DJANGO_TRUSTED_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Safaricom Daraja (M-Pesa). Leave blank until sandbox credentials are issued.
# Do not commit real consumer keys, secrets, passkeys, or shortcodes.
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://<public-host>/api/v1/billing/mpesa/callback/<token>/
# MPESA_CALLBACK_AUTH_TOKEN=
# Put the same token in the callback URL path, not the query string. Daraja callbacks are unsigned.
# MPESA_TIMEOUT_SECONDS=30
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
